{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file-if-exists=../../.env",
        "dist/src/server.js"
      ],
      "cwd": "apps/api",
      "port": 3001
    },
    {
      "name": "api-pruebas",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file-if-exists=../../.env",
        "--env-file=pruebas.env",
        "dist/src/server.js"
      ],
      "cwd": "apps/api",
      "port": 3002
    },
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "../../node_modules/vite/bin/vite.js",
        "--port",
        "5180",
        "--host",
        "127.0.0.1"
      ],
      "cwd": "apps/web",
      "port": 5180,
      "url": "http://127.0.0.1:5180"
    },
    {
      "name": "web-pruebas",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.API_PROXY='http://127.0.0.1:3002';process.argv.splice(1,0,'vite','--port','5182','--host','127.0.0.1');import('../../node_modules/vite/bin/vite.js')"
      ],
      "cwd": "apps/web",
      "port": 5182,
      "url": "http://127.0.0.1:5182"
    },
    {
      "name": "movil-web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path');const r=p.resolve('build/web');const t={'.html':'text/html','.js':'text/javascript','.json':'application/json','.wasm':'application/wasm','.otf':'font/otf','.ttf':'font/ttf','.png':'image/png'};h.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]);let f2=p.join(r,u);if(!f2.startsWith(r)||!f.existsSync(f2)||f.statSync(f2).isDirectory())f2=p.join(r,'index.html');s.writeHead(200,{'Content-Type':t[p.extname(f2)]||'application/octet-stream'});f.createReadStream(f2).pipe(s)}).listen(5181,'127.0.0.1')"
      ],
      "cwd": "apps/mobile",
      "port": 5181,
      "autoPort": false,
      "url": "http://127.0.0.1:5181"
    }
  ]
}
