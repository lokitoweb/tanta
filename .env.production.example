# Producción — copia a .env.production y completa los valores.
# NUNCA subas este archivo al repositorio.

DOMINIO=tantapanaderia.com
CORREO=admin@tantapanaderia.com

# Base de datos
PGUSER=tanta
PGPASSWORD=CAMBIA_ESTO_por_una_clave_larga_y_aleatoria
PGDATABASE=tanta
# Rol con el que atiende el API (sin privilegios de administración). Mínimo 16 caracteres.
APP_DB_USER=tanta_app
APP_DB_PASSWORD=CAMBIA_ESTO_por_otra_clave_larga_y_aleatoria

# Secreto de firma de tokens. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIA_ESTO_por_48_bytes_aleatorios
# Cifra en la base los secretos de Configuración (Firebase, webhook). Distinta de JWT_SECRET.
CONFIG_KEY=CAMBIA_ESTO_por_32_bytes_aleatorios

# Orígenes permitidos (separados por coma, sin barra final)
CORS_ORIGINS=https://tantapanaderia.com,https://www.tantapanaderia.com

# Intentos de login por minuto y por IP
LOGIN_RATE_MAX=8

# Días de retención de respaldos
RETENCION_DIAS=30

# --- Servidor compartido (ya hay Nginx en 80/443 con otros sitios) ---
# Caddy escucha solo en el propio servidor y Nginx le pasa el tráfico con su certificado (certbot).
# En un servidor solo para Tanta, borra estas 4 líneas: Caddy toma 80/443 y saca el certificado solo.
SITIO=:80
PUERTO_HTTP=127.0.0.1:8090
PUERTO_HTTPS=127.0.0.1:8453
PROXY_CONFIABLE=private_ranges
