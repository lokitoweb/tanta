# API de pruebas local: misma configuración que .env pero con su propia base de datos y puerto.
# Las pruebas automáticas crean y anulan datos: así nunca tocan la base en la que se usa el sistema.
# Sin secretos: la contraseña de la base sigue en .env.
PGDATABASE=tanta_test
PORT=3002
LOGIN_RATE_MAX=1000
# Las pruebas automáticas entran sin código de dos pasos (la API diaria sí lo exige).
MFA_OBLIGATORIO=false
