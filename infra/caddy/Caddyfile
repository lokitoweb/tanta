# Caddy: TLS automático (Let's Encrypt), cabeceras de seguridad y SPA.
# Sustituye {$DOMINIO} por tantapanaderia.com en el .env.production.

# Detrás de otro proxy (Nginx del servidor con su propio TLS) confía en su X-Forwarded-For;
# sin proxy, PROXY_CONFIABLE queda en 127.0.0.1/32 y nadie puede falsear su IP.
{
	servers {
		trusted_proxies static {$PROXY_CONFIABLE:127.0.0.1/32}
	}
}

# SITIO: por defecto "dominio, www.dominio" (TLS automático). Detrás de Nginx: ":80" (solo HTTP interno).
{$SITIO} {
	encode zstd gzip

	# --- Seguridad ---
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' https://{$DOMINIO}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# El certificado y la clave privada nunca se sirven.
	# path_regexp, no path: path usa comodines y la expresión anterior nunca coincidía.
	# Bloquea archivos ocultos (.env, .git…) y extensiones sensibles.
	# Va en su propio handle: un respond suelto se evalúa DESPUÉS de los handle (la web lo tapaba).
	@noPermitido path_regexp (?i)(/\.|\.(env|sql|log|pem|key|bak|dump|gz|zip)$)
	handle @noPermitido {
		respond 404
	}

	# --- API ---
	handle /api/* {
		reverse_proxy api:3001 {
			header_up X-Real-IP {client_ip}
			# Sin chequeo activo (dejaba el API fuera ~2 min al arrancar): Docker ya vigila su salud.
			# Durante un reinicio del API, Caddy reintenta hasta 15 s antes de responder error.
			lb_try_duration 15s
			lb_try_interval 250ms
		}
	}

	# --- Aplicación web (SPA) ---
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server

		# Los assets con hash se cachean para siempre; el index nunca.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path /index.html
		header @html Cache-Control "no-cache"
	}

	log {
		output stdout
		format json
	}
}
